{
  "restart.cmd": [
    "echo @echo off >> \"%systemdrive%\\Ghost Toolbox\\wget\\restart.cmd\"",
    "echo TITLE Ghost Toolbox - Restart >nul >> \"%systemdrive%\\Ghost Toolbox\\wget\\restart.cmd\"",
    "echo cd \"%Systemdrive%\\Ghost Toolbox\" >nul >> \"%systemdrive%\\Ghost Toolbox\\wget\\restart.cmd\"",
    "echo timeout /t 2 >nul >> \"%systemdrive%\\Ghost Toolbox\\wget\\restart.cmd\"",
    "echo start toolbox.updater.x64.exe >nul >> \"%systemdrive%\\Ghost Toolbox\\wget\\restart.cmd\"",
    "echo del /s /q wget\\restart.cmd >nul >> \"%systemdrive%\\Ghost Toolbox\\wget\\restart.cmd\"",
    "echo exit >> \"%systemdrive%\\Ghost Toolbox\\wget\\restart.cmd\"",
